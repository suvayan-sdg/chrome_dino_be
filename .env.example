# Server environment (never commit .env)

# Required: MongoDB Atlas connection string (Atlas IP allowlist must include your
# Render egress/Cloudflare ranges when deployed). Gameplay tuning constants live
# in src/shared/constants.ts, NOT here.
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority

# Server port
PORT=4000

# Allowed CORS origins (client). Comma-separated. Include your GitHub Pages URL
# when deployed, plus localhost for dev. Socket.IO needs this too.
CLIENT_ORIGIN=http://localhost:5173

# Node environment
NODE_ENV=development

# Operational tuning (server behavior). Gameplay mechanics (clamps, ramps, lives,
# durations, spacing curve) stay in shared/constants.ts and are duplicated to the
# client so both sides agree.
MATCH_DURATION_SECONDS=60
TICK_RATE_HZ=20
ROOM_CODE_LENGTH=4
MAX_PLAYERS_PER_ROOM=4
RECONNECT_GRACE_SECONDS=15
ROOM_TTL_HOURS=24
